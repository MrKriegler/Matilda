{
  "name": "matilda",
  "version": "1.0.0",
  "description": "Open source Task management software for service based work. i.e. Plumbers, Steal work, etc",
  "main": "index.js",
  "scripts": {
    "tests": "mocha --require ts-node/register --require tsconfig-paths/register --recursive tests/**/*.spec.ts",
    "start": "DEBUG=* node --require tsconfig-paths/register --inspect=5858 -r ts-node/register ./src/index.ts",
    "start:watch": "nodemon",
    "build": "tsc"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "npm start",
    "ext": "ts"
  },
  "keywords": [],
  "author": "Noel Kriegler <n.kriegler@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/chance": "^1.1.0",
    "@types/debug": "^4.1.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "chance": "^1.1.0",
    "mocha": "^10.8.0",
    "nodemon": "^3.1.0",
    "superagent": "^8.1.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "debug": "^4.3.0",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
